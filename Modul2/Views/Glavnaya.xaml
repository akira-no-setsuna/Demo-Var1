<Window x:Class="Modul2.Glavnaya"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Modul2"
        mc:Ignorable="d"
        Title="Glavnaya" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{StaticResource SecondaryBackground}"
                   LastChildFill="False">
            <Button Content="Выход" DockPanel.Dock="Right" Background="{StaticResource Accent}"
                    Width="70" Click="ExitButton_Click"/>
            <Label x:Name="UserFullName" DockPanel.Dock="Right"/>
            <Image Source="/resourсes/icon.png" Stretch="Fill" Width="30"/>
        </DockPanel>

        <StackPanel x:Name="AdminPanel" Grid.Row="2" Orientation="Horizontal" Margin="5" Visibility="Visible">
            <Button Content="Добавить товар" Width="150" Margin="0,0,10,0" Click="AddProduct_Click"/>
            <Button Content="Удалить товар" Width="150" Background="#FFB4B4" Margin="0,0,10,0" Click="DeleteProduct_Click"/>
            <Button Content="Заказы" Click="btnOrders_Click" Width="150" Background="#FFB4B4" HorizontalAlignment="Right" />
        </StackPanel>

        <StackPanel x:Name="StaffPanel"  Grid.Row="1" Orientation="Horizontal" Margin="5">
            <TextBox x:Name="SearchTextBox" 
                     Width="250" 
                     Margin="0,0,10,0"
                     TextChanged="SearchTextBox_TextChanged">
            </TextBox>

            <ComboBox x:Name="SortComboBox"
                      Width="230"
                      SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию количества"/>
                <ComboBoxItem Content="По убыванию количества"/>
            </ComboBox>

            <ComboBox x:Name="FiltrationComboBox"
                      Width="230"
                      SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Все поставщики"/>
            </ComboBox>
        </StackPanel>

        <ListView Grid.Row="3" x:Name="CardsContainer" MouseLeftButtonUp="CardsContainer_MouseLeftButtonUp" >
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:KartochkaTovara />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListView>

    </Grid>
</Window>