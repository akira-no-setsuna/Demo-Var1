<UserControl x:Class="Modul2.KartochkaTovara"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Modul2"
        mc:Ignorable="d"
        Height="auto" Width="700"
             Background="{Binding RowBackground}">
    <Border Padding="10" Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Image Source="{Binding PhotoPath, 
                FallbackValue='pack://application:,,,/Resources/picture.png', 
                TargetNullValue='pack://application:,,,/Resources/picture.png'}" />

            <Border Grid.Column="2" Padding="10,5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CategoryAndName}" TextWrapping="Wrap" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Description, StringFormat='Описание товара: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Manufacturer, StringFormat='Производитель: {0}'}"  />
                    <TextBlock Text="{Binding Supplier, StringFormat='Поставщик: {0}'}" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Цена: " />
                        <TextBlock Text="{Binding Cost, StringFormat='{}{0:N2}'}" 
                                   Foreground="Red"
                                   TextDecorations="Strikethrough"
                                   Visibility="{Binding HasSale}" />
                        <TextBlock Text="{Binding FinalCost, StringFormat=' {0:N2} руб.'}" />
                    </StackPanel>
                    
                    <TextBlock Text="Единица измерения: Штуки" />
                    <TextBlock Text="{Binding Quantity, StringFormat='Количество на складе: {0}'}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Padding="5">
                <TextBlock Text="{Binding Sale, StringFormat='Действующая скидка;{0}%'}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
