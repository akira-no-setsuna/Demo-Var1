<Window x:Class="Modul2.Views.RedactirovanieZakaza"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Modul2.Views"
        mc:Ignorable="d"
        Title="Редактирование заказа" Height="400" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Артикул заказа:" VerticalAlignment="Center" Margin="0,10,10,10"/>
        <TextBox x:Name="txtCode" Grid.Row="0" Grid.Column="1" Margin="0,10,0,10" Padding="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус заказа:" VerticalAlignment="Center" Margin="0,10,10,10"/>
        <ComboBox x:Name="cbStatus" Grid.Row="1" Grid.Column="1" Margin="0,10,0,10" Padding="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес пункта выдачи:" VerticalAlignment="Center" Margin="0,10,10,10"/>
        <ComboBox x:Name="cbAddress" Grid.Row="2" Grid.Column="1" Margin="0,10,0,10" Padding="5" 
          DisplayMemberPath="Name" 
          SelectedValuePath="ID"/>
        <!-- Добавьте эту строку -->

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата заказа:" VerticalAlignment="Center" Margin="0,10,10,10"/>
        <DatePicker x:Name="dpCreateDate" Grid.Row="3" Grid.Column="1" Margin="0,10,0,10" Padding="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата выдачи:" VerticalAlignment="Center" Margin="0,10,10,10"/>
        <DatePicker x:Name="dpDeliveryDate" Grid.Row="4" Grid.Column="1" Margin="0,10,0,10" Padding="5"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Click="btnSave_Click" Width="100" Padding="5" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
            <Button Content="Отмена" Click="btnCancel_Click" Width="100" Padding="5" Background="#F44336" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>