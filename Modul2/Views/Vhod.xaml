<Window x:Class="Modul2.Vhod"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Modul2"
        mc:Ignorable="d"
        Title="Vhod" Height="298" Width="265">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Логин"/>
        <TextBox TextWrapping="Wrap" Width="120" x:Name="Login_TextBox"/>
        <Label Content="Пароль"/>
        <PasswordBox  Width="120" x:Name="PasswordBox"/>
        <Button Content="Войти" Click="SignInButton_Click" Margin="0 10 0 0"/>
        <Button Content="Войти как гость" Click="QuestSignInButton_Click"/>
    </StackPanel>
</Window>
