<Window x:Class="Modul2.Glavnaya"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Modul2"
        mc:Ignorable="d"
        Title="Glavnaya" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row = "0"  Background="{StaticResource SecondaryBackground}"
            LastChildFill="False">
            <Button Content="Выход"  DockPanel.Dock="Right" Background="{StaticResource Accent}" Width="70" Click="ExitButton_Click"/>
            <Label x:Name = "UserFullName" DockPanel.Dock="Right"/>
            <Image Source="/resourсes/icon.png" Stretch="Fill" Width="30"/>
        </DockPanel>

        <ListView  Grid.Row = "1" x:Name="CardsContainer" >
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:KartochkaTovara />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListView>

    </Grid>
</Window>
